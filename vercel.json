{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip install",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/nhac/:slug", "destination": "/nhac/index.html" }
  ],
  "headers": [
    {
      "source": "/nhac/(assets|media)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
