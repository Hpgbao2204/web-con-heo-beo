# Đặt các biến này trong Vercel (Project → Settings → Environment Variables).
# `vercel env pull .env.local` để kéo về khi chạy `vercel dev`.
ADMIN_KEY=            # mật khẩu trang Tạo mã / Thư viện
STATS_KEY=            # khoá xem /api/stats?key=...
MAX_UPLOAD_MB=20
# PUBLIC_BASE_URL=    # bỏ trống = dùng domain production của Vercel
# BLOB_READ_WRITE_TOKEN, KV_REST_API_URL, KV_REST_API_TOKEN: Vercel tự thêm khi kết nối Blob / Upstash
